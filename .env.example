# Copy this file to .env and adjust if needed. Never commit the real .env.

# FastAPI app database location (relative to project root)
DATABASE_URL=sqlite:///./data/defect_tracker.db

# Host/port the FastAPI app binds to. Keep 127.0.0.1 for local-only MVP use.
APP_HOST=127.0.0.1
APP_PORT=8000

# Timezone used for displaying timestamps (storage is always UTC)
DISPLAY_TIMEZONE=America/New_York

# Max photo upload size in megabytes
MAX_UPLOAD_MB=8

# Where uploaded defect photos are stored. Defaults to ./uploads inside the project
# (unchanged local-dev behavior) if unset. On Render this is set to a subdirectory
# of the mounted persistent disk (see render.yaml) - without that override, photos
# would live on the ephemeral container filesystem and be lost on every redeploy.
# UPLOADS_DIR=./uploads

# Used by mcp_server/server.py to reach the FastAPI REST API
DEFECT_API_URL=http://127.0.0.1:8000

# Eagle production brief JSON API - source of truth for Customer Issues sync.
# Currently pointed at a local test instance for development. Set this to the real
# production address (http://20.62.194.32:8094) in your real .env when that
# instance is ready - never hardcode either address in application code.
PRODUCTION_BRIEF_URL=http://127.0.0.1:8094
SYNC_INTERVAL_MINUTES=60

# Seed value only - written into the app_settings table the first time the app
# starts against a fresh database. After that, the rate is edited on the Admin
# screen and this env var has no further effect. Placeholder until Eagle confirms
# the real average drawer production cost.
DEFAULT_COST_PER_DRAWER=35.00

# Single shared login for the whole app (Phase 2 - see app/services/auth_service.py).
# One username/password gates the entire app - there are no per-user accounts or
# roles. NEVER put the real plaintext password here or in application code.
# APP_PASSWORD_HASH must be a bcrypt hash, generated with e.g.:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-real-password', bcrypt.gensalt()).decode())"
APP_USERNAME=changeme
APP_PASSWORD_HASH=changeme

# Phase 3 relay: Render's servers cannot reach the production brief directly (a
# firewall on the production brief's side blocks it), so a local script
# (scripts/relay_customer_issues.py) fetches the data and forwards it to the live
# app's ingest endpoint instead. RELAY_API_KEY is a separate secret from
# APP_USERNAME/APP_PASSWORD_HASH above - a human password rotation must never
# break this automated relay and vice versa. Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the SAME value here (for the app to check) and in scripts/relay_customer_
# issues.py's own .env below (for it to send) - and in Render's dashboard for the
# deployed app. Phase 6 (drawers-scheduled sync, docs/PROJECT_SPEC_PHASE6.md)
# reuses this exact same key for its own independent relay pass - no new secret.
RELAY_API_KEY=changeme

# Brief Export (Part A): the Eagle production brief (a separate app/server, owned
# by Blake) fetches GET /api/v1/brief/summary daily to build the drawers TV board.
# Checked against the X-Brief-Key header on that one endpoint - a separate secret
# from RELAY_API_KEY above (different machine, opposite direction: the brief's VM
# calls this app directly, there is no relay). Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the SAME value here (for this app to check) and wherever the production
# brief's generator is configured to send it, and in Render's dashboard for the
# deployed app. Leaving this unset/empty means the endpoint rejects every
# request - it never falls back to accepting unauthenticated calls.
BRIEF_API_KEY=changeme

# Used only by scripts/relay_customer_issues.py and scripts/relay_poll.py (not
# read by the FastAPI app itself) - the live Render app's base URL, e.g.
# https://your-app.onrender.com. scripts/relay_poll.py is a companion script
# intended to run every ~1 minute (a separate, more frequent Task Scheduler entry
# from relay_customer_issues.py's existing hourly one) - it polls a cheap
# heartbeat endpoint and only runs a full relay pass when the Customer Issues
# tab's "Sync Now" button has requested one.
RENDER_URL=https://changeme.onrender.com

# Label-scan OCR (docs/PROJECT_SPEC_PHASE9.md Part 3): reads the work order line
# off the shop's existing printed label by camera, on the New Defect form. Writes
# nothing to the database itself (line_label is saved as a normal case field once
# the operator submits) - see app/services/ocr_service.py and app/routers/scan.py.
# Ships LIVE by default (unlike other optional features here): the default engine
# runs entirely in the browser, costs nothing, and needs no credential.
OCR_ENABLED=true
# "tesseract" (default - runs in the browser via vendored Tesseract.js, free, no
# key, no server round trip for recognition), "anthropic", "azure", or "google".
# The three cloud options require OCR_API_KEY (and OCR_ENDPOINT for Azure) and are
# only ever called from app/routers/scan.py's /diagnose route - "tesseract" never
# touches that route at all. Switching cloud providers is just changing this value
# plus the key/endpoint below - no code change needed.
OCR_PROVIDER=tesseract
# Azure Computer Vision resource endpoint, e.g. https://your-resource.cognitiveservices.azure.com
# Only read when OCR_PROVIDER=azure.
OCR_ENDPOINT=
# Secret, only read for the cloud providers. Azure: an Ocp-Apim-Subscription-Key
# for the Computer Vision resource at OCR_ENDPOINT above. Google: an API key with
# the Vision API enabled. Anthropic: an API key for the Messages API. NEVER commit
# a real value here. Leaving this empty is fine (and the default) when
# OCR_PROVIDER=tesseract - that path needs no key at all.
OCR_API_KEY=

# Phase 3: quick-pick favorites bars (up to 5 stations + up to 5 defect
# categories, admin-managed - see app/services/master_data_service.py) on the
# New Defect form. Ships OFF by default (unlike OCR_ENABLED above) - unlike
# OCR, this visibly changes the entry form's layout, so a deploy alone must
# never turn it on; flip to true only once Admin has actually favorited
# something and you're ready for the shop floor to see it.
FAVORITES_ENABLED=false
